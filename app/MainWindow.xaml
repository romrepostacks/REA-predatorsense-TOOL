<Window x:Class="ReaSense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REA Sense" Width="1000" Height="680" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- Effect gallery tile -->
        <Style x:Key="EffectTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="132"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{StaticResource Bg}" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#2A2F3A"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Light"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" Margin="0,0,10,0"/>
                    <TextBlock Text="REA Sense" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="ModelText" Foreground="{StaticResource Muted}" Margin="12,0,0,0" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleButton}" Click="Minimize_Click" ToolTip="Hide to tray"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TitleButton}" Click="Close_Click" ToolTip="Quit (fans return to auto)"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <DockPanel Margin="12,4,12,16">
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavFans" Style="{StaticResource Nav}" Content="Fans" GroupName="Nav" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavLighting" Style="{StaticResource Nav}" Content="Lighting" GroupName="Nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPerformance" Style="{StaticResource Nav}" Content="Performance" GroupName="Nav" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="Settings" GroupName="Nav" Checked="Nav_Checked"/>
                    </StackPanel>
                    <TextBlock x:Name="SideStatus" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="14,0"/>
                </DockPanel>

                <Grid Grid.Column="1" Margin="8,4,24,16">
                    <!-- ===== Fans ===== -->
                    <ScrollViewer x:Name="PageFans" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,6,12">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Style="{StaticResource Heading}"/>
                                        <TextBlock x:Name="CpuTemp" Text="--°C" Style="{StaticResource BigNumber}"/>
                                        <TextBlock x:Name="CpuFan" Text="-- rpm" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="6,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="GPU" Style="{StaticResource Heading}"/>
                                        <TextBlock x:Name="GpuTemp" Text="--°C" Style="{StaticResource BigNumber}"/>
                                        <TextBlock x:Name="GpuFan" Text="-- rpm" Foreground="{StaticResource Muted}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FAN MODE" Style="{StaticResource Heading}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeAuto" Content="Auto" Style="{StaticResource Segment}" GroupName="Fan" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="ModeMax" Content="Max" Style="{StaticResource Segment}" GroupName="Fan" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="ModeCustom" Content="Custom" Style="{StaticResource Segment}" GroupName="Fan" Checked="Mode_Checked"/>
                                        <RadioButton x:Name="ModeCurve" Content="Curve" Style="{StaticResource Segment}" GroupName="Fan" Checked="Mode_Checked"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FanMsg" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CustomCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="CUSTOM SPEED" Style="{StaticResource Heading}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="CPU" VerticalAlignment="Center"/>
                                        <Slider x:Name="CpuSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=CpuSlider, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="GPU" VerticalAlignment="Center"/>
                                        <Slider x:Name="GpuSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GpuSlider, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CurveCard" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="FAN CURVE" Style="{StaticResource Heading}"/>
                                    <Border Background="{StaticResource Bg}" CornerRadius="8" Height="160" Padding="8">
                                        <Canvas x:Name="CurvePlot" ClipToBounds="True">
                                            <Polyline x:Name="CurveLine" Stroke="{StaticResource Accent}" StrokeThickness="2.5" StrokeLineJoin="Round"/>
                                            <Line x:Name="CurveNow" Stroke="{StaticResource Warn}" StrokeThickness="1" StrokeDashArray="3 3" Visibility="Collapsed"/>
                                        </Canvas>
                                    </Border>
                                    <TextBlock Text="Points as temperature:fan%. Fans follow an averaged temperature and change gradually, and go to 100% at 92°C."
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Apply curve" Style="{StaticResource Primary}" Click="ApplyCurve_Click" Margin="8,0,0,0"/>
                                        <TextBox x:Name="CurveText" TextChanged="CurveText_TextChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="SMART TUNE" Style="{StaticResource Heading}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Plug in the charger, start a heavy GPU load (a game, ComfyUI), then start. Both fans start at 100% and step down through 85, 70, 55 and 40%, holding each until temperatures settle (10 to 20 minutes in all). If a chip reaches 95°C it stops stepping down. It then finds the speed past which more fan noise buys little cooling, and builds a gentle curve around it. Every fan reading is also logged to %APPDATA%\ReaSense\fanlog.csv."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TuneStart" Content="Start Smart Tune" Style="{StaticResource Primary}" Click="TuneStart_Click"/>
                                        <CheckBox x:Name="TuneCpuLoad" Content="Load all CPU cores during the test" IsChecked="True" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TuneMsg" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <StackPanel x:Name="TuneResult" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock x:Name="TuneTable" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Use this curve" Style="{StaticResource Primary}" Click="TuneUse_Click" Margin="8,0,0,0"/>
                                            <TextBox x:Name="TuneCurve"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Lighting ===== -->
                    <ScrollViewer x:Name="PageLighting" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="PREVIEW" Style="{StaticResource Heading}"/>
                                    <Border Background="#0A0B0E" CornerRadius="12" Padding="14" Height="130">
                                        <UniformGrid x:Name="BigPreview" Columns="4"/>
                                    </Border>
                                    <TextBlock x:Name="EffectDesc" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="BUILT-IN EFFECTS" Style="{StaticResource Heading}"/>
                                    <WrapPanel x:Name="NativeEffects"/>
                                    <TextBlock Text="APP EFFECTS (RUN WHILE THE APP IS OPEN)" Style="{StaticResource Heading}" Margin="0,8,0,10"/>
                                    <WrapPanel x:Name="AppEffects"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="COLORS AND MOTION" Style="{StaticResource Heading}"/>
                                    <StackPanel x:Name="ZoneButtons" Orientation="Horizontal" Margin="0,0,0,14"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Brightness" VerticalAlignment="Center"/>
                                        <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BrightSlider, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid x:Name="SpeedRow" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Speed" VerticalAlignment="Center"/>
                                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="1" Maximum="9" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=SpeedSlider}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel x:Name="DirRow" Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="Direction" Width="90" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="DirRtl" Content="Right to left" Style="{StaticResource Segment}" GroupName="Dir" Checked="Preview_Changed"/>
                                        <RadioButton x:Name="DirLtr" Content="Left to right" Style="{StaticResource Segment}" GroupName="Dir" Checked="Preview_Changed"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,16,0,0">
                                        <Button DockPanel.Dock="Right" Content="Apply to keyboard" Style="{StaticResource Primary}" Click="ApplyLighting_Click"/>
                                        <TextBlock x:Name="LightMsg" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Performance ===== -->
                    <ScrollViewer x:Name="PagePerformance" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="GPU OVERCLOCK" Style="{StaticResource Heading}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="OcNormal" Content="Normal" Tag="0" Style="{StaticResource Segment}" GroupName="Oc" Click="Oc_Click"/>
                                        <RadioButton x:Name="OcFaster" Content="Faster" Tag="1" Style="{StaticResource Segment}" GroupName="Oc" Click="Oc_Click"/>
                                        <RadioButton x:Name="OcTurbo" Content="Turbo" Tag="2" Style="{StaticResource Segment}" GroupName="Oc" Click="Oc_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="OcMsg" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Text="PredatorSense's GPU presets. Start from a cool laptop and go back to Normal if games crash. Quitting the app returns to Normal. On some models these may have no effect."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Settings ===== -->
                    <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="GENERAL" Style="{StaticResource Heading}"/>
                                    <CheckBox x:Name="ChkStartup" Content="Start with Windows (in the tray, in your last fan mode)" Click="ChkStartup_Click"/>
                                    <CheckBox x:Name="ChkDisclaimer" Content="Show the disclaimer at startup" Click="ChkDisclaimer_Click"/>
                                    <CheckBox x:Name="ChkUntested" Content="Allow controls on this untested model" Click="ChkUntested_Click"/>
                                    <TextBlock x:Name="SettingsMsg" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="COMPATIBILITY CHECK" Style="{StaticResource Heading}"/>
                                    <TextBlock x:Name="CompatText" LineHeight="22"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ABOUT" Style="{StaticResource Heading}"/>
                                    <TextBlock x:Name="AboutText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
